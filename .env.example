NEXT_PUBLIC_POSTGREST_BASE=https://tigerblue-postgrest.fly.dev

# Optional: if/when you secure PostgREST with JWT
# POSTGREST_AUTH_TOKEN=

# Optional: semantic neighbour gateway (not currently used by the frontend code)
NEXUS_BASE=https://cyberscape-nexus.fly.dev

# Optional: Cyberscape Nexus API key if/when you enable it
# NEXUS_API_KEY=
